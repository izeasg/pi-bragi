  "description": "Pi extension to manage a central skills repository and toggle skills or skill groups globally or per project",
  "type": "module",
  "keywords": [
    "pi-package",
    "skills",
    "bragi"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
